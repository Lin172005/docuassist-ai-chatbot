# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/docuassist
DB_SSLMODE=prefer

# Gemini API Key (get from: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Embedding Model (default: gemini-embedding-2)
EMBEDDING_MODEL=gemini-embedding-2

# Embedding Dimensions (default: 768)
EMBEDDING_DIMENSIONS=768

# CORS - Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# JWT Authentication
JWT_SECRET=84fa3421255612a4f15bfffcef3085747e01e02877835f38ceb0c40a33272512
JWT_EXPIRE_MINUTES=1440
